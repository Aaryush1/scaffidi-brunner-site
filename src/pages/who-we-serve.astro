---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Testimonials from '../components/Testimonials.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { audiences, whoWeServe } from '../content/firm';
import { services } from '../content/services';
---
<Base title="Who We Serve" description={whoWeServe.intro}>
  <PageHero eyebrow={whoWeServe.eyebrow} title={whoWeServe.heading} lede={whoWeServe.intro} image="/media/business-buildings.jpg" />

  <section class="section">
    <div class="wrap list">
      {audiences.map((a, i) => (
        <article class:list={['aud', { flip: i % 2 === 1 }]} id={a.id} data-reveal>
          <div class="img"><img src={a.image} alt="" width="900" height="600" loading="lazy" /></div>
          <div class="txt">
            <p class="eyebrow">{String(i + 1).padStart(2, '0')} · Who we serve</p>
            <h2 class="h-section">{a.name}</h2>
            <p class="tagline">{a.tagline}</p>
            <p>{a.body}</p>
            <ul class="svc" role="list" aria-label={`Services for ${a.name}`}>
              {services.filter((s) => s.audiences.includes(a.id)).map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap"><Testimonials /></div>
  </section>
  <ClosingCta />
</Base>

<style>
  .list { display: grid; gap: clamp(64px, 9vw, 120px); }
  .aud { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; scroll-margin-top: 100px; }
  .aud.flip .img { order: 2; }
  .img { border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 3; }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  .h-section { margin-top: 14px; }
  .tagline { margin: 16px 0 14px; font-family: var(--font-display); color: var(--accent-text); font-size: 1.3rem; }
  .svc { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .svc a { display: inline-block; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; font-size: .8rem; text-decoration: none; color: var(--heading); transition: border-color .2s; }
  .svc a:hover { border-color: var(--accent); }
  @media (max-width: 860px) { .aud { grid-template-columns: 1fr; } .aud.flip .img { order: 0; } }
</style>
