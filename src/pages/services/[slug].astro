---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { services, isListed, type Service } from '../../content/services';
import { audiences, testimonials } from '../../content/firm';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service: s } = Astro.props as { service: Service };
const others = services.filter((o) => o.slug !== s.slug && isListed(o));
const forWhom = audiences.filter((a) => s.audiences.includes(a.id));
const quote = testimonials.find((t) => t.services.includes(s.slug)) ?? testimonials[0];
---
<Base title={s.title} description={s.summary}>
  <PageHero eyebrow={s.eyebrow} title={s.heading} lede={s.intro.join(' ')} image={s.image} compact>
    <a class="btn btn-solid" href="/contact/">Schedule a consultation</a>
  </PageHero>

  <section class="section">
    <div class="wrap body">
      <aside class="side">
        <div class="who" data-who-for>
          <p class="eyebrow">Who this is for</p>
          <ul role="list">{forWhom.map((a) => <li><a href={`/who-we-serve/#${a.id}`}>{a.name}</a></li>)}</ul>
        </div>
        <figure class="quote">
          <blockquote><p>{quote.quote}</p></blockquote>
          <figcaption>{quote.name} <span>· Client</span></figcaption>
        </figure>
      </aside>
      <div class="main">
        <p class="eyebrow">{s.title}</p>
        <h2 class="h-section">{s.pillarsHeading}</h2>
        <ol class="pillars" role="list">
          {s.pillars.map((p, i) => (
            <li>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div><h3 class="h-card">{p.title}</h3><p>{p.body}</p></div>
            </li>
          ))}
        </ol>
        <blockquote class="closing">
          <p class="c-title">{s.closingTitle}</p>
          <p>{s.closingBody}</p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="other-h">
    <div class="wrap">
      <h2 id="other-h" class="eyebrow">Other capabilities</h2>
      <div class="others"><ServiceIndex items={others} compact /></div>
    </div>
  </section>
  <ClosingCta />
</Base>

<style>
  .body { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: clamp(40px, 7vw, 100px); align-items: start; }
  .side { position: sticky; top: 108px; display: grid; gap: 28px; }
  .quote { margin: 0; padding: 28px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); display: grid; gap: 16px; }
  .quote blockquote { margin: 0; }
  .quote p { font-family: var(--font-display); color: var(--heading); font-size: 1.2rem; line-height: 1.45; }
  .quote figcaption { font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: var(--accent-text); font-weight: 500; }
  .quote figcaption span { color: var(--muted); }
  .who { display: grid; gap: 12px; }
  .who ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .who a { display: inline-block; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; font-size: .85rem; text-decoration: none; color: var(--heading); transition: border-color .2s; }
  .who a:hover { border-color: var(--accent); }
  .main { display: grid; gap: 18px; }
  .pillars { list-style: none; margin: 18px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .pillars li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 16px; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .num { font-family: var(--font-display); color: var(--accent-text); padding-top: 4px; }
  .pillars p { margin-top: 8px; color: var(--text); }
  .closing { margin: 32px 0 0; padding: 4px 0 4px 28px; border-left: 2px solid var(--gold); display: grid; gap: 10px; }
  .c-title { font-family: var(--font-display); color: var(--heading); font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .closing p:last-child { color: var(--text); font-size: 1.05rem; }
  .others { margin-top: 20px; }
  @media (max-width: 900px) {
    .body { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
  }
</style>
