---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import AudiencePicker from '../../components/AudiencePicker.astro';
import { differentiators } from '../../content/firm';
import { services, isListed } from '../../content/services';
---
<Base title="Services" description={differentiators.complete.body[1]}>
  <PageHero eyebrow={differentiators.eyebrow} title={differentiators.heading} lede={differentiators.complete.body[1]} image="/media/tax-guidance.jpg" compact />

  <section class="section" id="capabilities">
    <div class="wrap">
      <SectionHead eyebrow="From proactive tax planning to complex transactions" title="Our Capabilities" />
      <AudiencePicker id="services" />
      <ServiceIndex items={services.filter(isListed)} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="lead">
        <h2 class="h-section">{differentiators.complete.heading}</h2>
        <p class="lede">{differentiators.complete.body[0]}</p>
      </div>
      <ul class="pillars" role="list">
        {differentiators.items.map((d) => <li><h3 class="h-card">{d.title}</h3><p>{d.body}</p></li>)}
      </ul>
    </div>
  </section>
  <ClosingCta />
</Base>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(40px, 7vw, 100px); align-items: start; }
  .lead { display: grid; gap: 22px; }
  .pillars { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 36px 32px; }
  .pillars li { border-top: 1px solid var(--accent); padding-top: 20px; display: grid; gap: 10px; align-content: start; }
  .pillars p { color: var(--text); }
  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .pillars { grid-template-columns: 1fr; } }
</style>
