---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ApproachSteps from '../components/ApproachSteps.astro';
import ClosingCta from '../components/ClosingCta.astro';
import AdvisorWeb from '../components/AdvisorWeb.astro';
import { approach, founders } from '../content/firm';
---
<Base title="Our Approach" description={approach.intro}>
  <PageHero eyebrow={approach.eyebrow} title={approach.heading} lede={approach.intro} image="/media/our-approach.jpg" />

  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">Understand, anticipate, strategize, execute</h2>
      <ApproachSteps detailed />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <SectionHead eyebrow="We uncover opportunities, risks, and considerations" title={approach.commodity.heading} />
      <div class="prose">{approach.commodity.body.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="section" id="advisors">
    <div class="wrap">
      <SectionHead eyebrow="From proactive tax planning to complex transactions" title={approach.together.heading}>
        {approach.together.body.map((p) => <p>{p}</p>)}
      </SectionHead>
      <AdvisorWeb />
    </div>
  </section>

  <section class="section">
    <div class="wrap founders">
      <h2 class="h-section">{founders.heading}</h2>
      <div class="prose">{founders.body.map((p) => <p>{p}</p>)}<p class="sig">— {founders.signature}</p></div>
    </div>
  </section>

  <ClosingCta />
</Base>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
  .prose { display: grid; gap: 18px; font-size: 1.05rem; }
  .prose p:last-child:not(.sig) { font-family: var(--font-display); color: var(--heading); font-size: 1.4rem; }
  .founders { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(32px, 6vw, 88px); }
  .sig { font-family: var(--font-display); font-style: italic; color: var(--accent-text); }
  @media (max-width: 860px) { .split, .founders { grid-template-columns: 1fr; } }
</style>
