---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  align?: 'left' | 'center';
  level?: 'h2' | 'h3';
}
const { eyebrow, title, id, align = 'left', level = 'h2' } = Astro.props;
const Tag = level;
---
<header class:list={['section-head', align]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag class="h-section" id={id}>{title}</Tag>
  {Astro.slots.has('default') && <div class="intro"><slot /></div>}
</header>

<style>
  .section-head { max-width: 760px; margin-bottom: clamp(36px, 5vw, 64px); }
  .section-head.center { margin-inline: auto; text-align: center; }
  .h-section { margin-top: 16px; }
  .intro { margin-top: 22px; display: grid; gap: 14px; }
  .intro :global(p) { font-size: 1.05rem; line-height: 1.75; }
</style>
