---
import ThemeToggle from './ThemeToggle.astro';
import { mainNav } from '../content/nav';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header on-navy" data-header>
  <div class="bar wrap">
    <a class="logo" href="/" aria-label="Scaffidi Brunner, home">
      <img src="/brand/ScaffidiBrunner_HorizontalLogo_WhiteGold.png" alt="" width="1000" height="214" />
    </a>

    <nav class="nav" aria-label="Main" id="site-nav">
      <ul role="list">
        {mainNav.map((item) => item.children ? (
          <li class="has-menu">
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            <button class="menu-trigger" type="button" aria-expanded="false" aria-controls="services-menu" aria-label="Services menu">
              <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <ul class="submenu" id="services-menu" role="list" hidden>
              {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn-solid nav-cta" href="/contact/">Schedule a consultation</a>
    </nav>

    <div class="tools">
      <ThemeToggle />
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const trigger = header.querySelector<HTMLButtonElement>('.menu-trigger')!;
  const menu = header.querySelector<HTMLElement>('#services-menu')!;
  const navToggle = header.querySelector<HTMLButtonElement>('.nav-toggle')!;

  const setMenu = (open: boolean) => {
    trigger.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  };
  trigger.addEventListener('click', () => setMenu(trigger.getAttribute('aria-expanded') !== 'true'));
  header.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (trigger.getAttribute('aria-expanded') === 'true') { setMenu(false); trigger.focus(); }
    else if (navToggle.getAttribute('aria-expanded') === 'true') { setNav(false); navToggle.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (!trigger.parentElement!.contains(e.target as Node)) setMenu(false);
  });
  trigger.parentElement!.addEventListener('focusout', (e) => {
    if (!trigger.parentElement!.contains(e.relatedTarget as Node)) setMenu(false);
  });

  const setNav = (open: boolean) => {
    navToggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('nav-open', open);
  };
  navToggle.addEventListener('click', () => setNav(navToggle.getAttribute('aria-expanded') !== 'true'));

  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: rgba(20, 32, 59, .92); backdrop-filter: saturate(1.2) blur(10px); border-bottom: 1px solid transparent; transition: border-color .3s var(--ease), background-color .3s var(--ease); }
  .site-header.scrolled { border-bottom-color: rgba(178, 144, 99, .28); background: rgba(13, 22, 41, .94); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .logo img { height: 42px; width: auto; }
  .nav { display: flex; align-items: center; gap: 28px; margin-left: auto; }
  .nav > ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; }
  .nav a:not(.btn) { color: #e7e3dc; text-decoration: none; font-size: .78rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; padding: 8px 0; border-bottom: 1px solid transparent; transition: color .2s, border-color .2s; }
  .nav a:not(.btn):hover, .nav a[aria-current='page'] { color: var(--gold-soft); border-bottom-color: var(--gold); }
  .has-menu { position: relative; display: flex; align-items: center; gap: 2px; }
  .menu-trigger { background: none; border: 0; color: var(--gold-soft); padding: 8px 6px; cursor: pointer; display: grid; place-items: center; }
  .menu-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .submenu { position: absolute; top: calc(100% + 12px); left: -20px; min-width: 300px; list-style: none; margin: 0; padding: 10px; background: var(--navy-deep); border: 1px solid rgba(178, 144, 99, .3); border-radius: 12px; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .8); }
  .submenu a:not(.btn) { display: block; padding: 11px 12px; border-radius: 8px; border: 0; text-transform: none; letter-spacing: .02em; font-size: .9rem; }
  .submenu a:not(.btn):hover { background: rgba(178, 144, 99, .12); }
  .nav-cta { padding: 12px 20px; font-size: .68rem; }
  .tools { display: flex; align-items: center; gap: 10px; }
  .nav-toggle { display: none; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; color: var(--gold-soft); }
  .bars { display: grid; gap: 7px; width: 24px; margin: auto; }
  .bars i { display: block; height: 1.5px; background: currentColor; transition: transform .3s var(--ease); }
  .nav-open .bars i:first-child { transform: translateY(4.25px) rotate(45deg); }
  .nav-open .bars i:last-child { transform: translateY(-4.25px) rotate(-45deg); }

  @media (max-width: 1080px) {
    :global(.js) .nav-toggle { display: block; }
    .bar { flex-wrap: wrap; }
    .tools { margin-left: auto; }
    .nav { order: 3; width: 100%; flex-direction: column; align-items: stretch; gap: 8px; padding: 8px 0 24px; }
    :global(.js) .nav { display: none; }
    :global(.js) .nav-open .nav { display: flex; }
    .nav > ul { flex-direction: column; gap: 0; }
    .nav > ul > li { border-bottom: 1px solid rgba(178, 144, 99, .18); }
    .nav a:not(.btn) { display: block; padding: 14px 0; font-size: .85rem; border: 0; }
    .has-menu { flex-wrap: wrap; justify-content: space-between; }
    .submenu { position: static; width: 100%; min-width: 0; background: transparent; border: 0; box-shadow: none; padding: 0 0 10px 12px; }
    .nav-cta { justify-content: center; margin-top: 12px; }
  }
</style>
