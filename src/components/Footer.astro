---
import { site } from '../config/site';
import { mainNav, serviceLinks } from '../content/nav';

const year = new Date().getFullYear();
const socials = [
  { href: site.social.linkedin, label: 'LinkedIn', d: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4V9.5Z' },
  { href: site.social.facebook, label: 'Facebook', d: 'M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.2c-.3 0-1.3-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3v2.2H7.6V12h2.7v10h3.7V12h2.7l.4-3.5H14Z' },
  { href: site.social.instagram, label: 'Instagram', d: 'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm4.9-8.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2ZM12 3.6c2.7 0 3 0 4.1.1 2.7.1 4 1.4 4.1 4.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 2.7-1.4 4-4.1 4.1-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1.1-.1-1.4-.1-4.1s0-3 .1-4.1c.1-2.7 1.4-4 4.1-4.1 1.1-.1 1.4-.1 4.1-.1ZM12 2c-2.7 0-3.1 0-4.2.1C4.2 2.2 2.2 4.2 2.1 7.8 2 8.9 2 9.3 2 12s0 3.1.1 4.2c.2 3.6 2.1 5.6 5.7 5.7 1.1.1 1.5.1 4.2.1s3.1 0 4.2-.1c3.6-.2 5.6-2.1 5.7-5.7.1-1.1.1-1.5.1-4.2s0-3.1-.1-4.2c-.2-3.6-2.1-5.6-5.7-5.7C15.1 2 14.7 2 12 2Z' },
  { href: site.social.x, label: 'X', d: 'M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.3-8.3L1.9 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z' },
];
---
<footer class="site-footer on-navy">
  <div class="wrap top">
    <div class="brand">
      <img src="/brand/ScaffidiBrunner_HorizontalLogo_WhiteGold.png" alt="Scaffidi Brunner, CPAs & Advisors" width="1000" height="214" loading="lazy" />
      <p class="tag">Partner-led tax planning and advisory for business owners, real estate investors, families, and family offices.</p>
      <ul class="social" role="list">
        {socials.map((s) => (
          <li><a href={s.href} rel="noopener" target="_blank"><span class="sr-only">{s.label} (opens in a new tab)</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={s.d} fill="currentColor" /></svg></a></li>
        ))}
      </ul>
    </div>

    <nav aria-label="Footer: firm" class="col">
      <h2 class="col-h">Firm</h2>
      <ul role="list">
        {mainNav.filter((n) => !n.children).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/careers/">Careers</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <nav aria-label="Footer: services" class="col">
      <h2 class="col-h">Services</h2>
      <ul role="list">{serviceLinks.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
    </nav>

    <div class="col">
      <h2 class="col-h">Visit</h2>
      <address>
        <a href={site.contact.mapsUrl} rel="noopener" target="_blank">{site.contact.addressLines.map((l) => <span>{l}</span>)}<span class="sr-only"> (opens map in a new tab)</span></a>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a href={site.contact.phoneHref}>{site.contact.phone}</a>
        <span class="hours">{site.contact.hours}</span>
      </address>
    </div>
  </div>

  <div class="wrap bottom">
    <p>© {year} Scaffidi Brunner CPAs &amp; Advisors. All rights reserved.</p>
    <ul role="list" class="legal">
      <li><a href="/privacy-policy/">Privacy Policy</a></li>
      <li><a href="/cookie-policy/">Cookie Policy</a></li>
      <li><a href="/terms-conditions/">Terms and Conditions</a></li>
      <li><a href="/accessibility-statement/">Accessibility Statement</a></li>
      <li><a href="/do-not-sell-or-share-my-personal-information/" class="iubenda-cs-uspr-link">Do Not Sell or Share My Personal Information</a></li>
      <li><button type="button" class="linkish iubenda-cs-preferences-link" data-consent-open>Your Privacy Choices</button></li>
      {site.showPersonalNote && <li><a href="/note/">A note from Aaryush</a></li>}
    </ul>
  </div>
</footer>

<style>
  .site-footer { padding-top: clamp(56px, 8vw, 96px); border-top: 1px solid rgba(178, 144, 99, .25); }
  .top { display: grid; grid-template-columns: 1.4fr 1fr 1.3fr 1.2fr; gap: 40px; padding-bottom: 56px; }
  .brand img { height: 48px; width: auto; }
  .tag { margin-top: 20px; font-size: .9rem; color: #b8bccb; max-width: 36ch; }
  .social { display: flex; gap: 10px; list-style: none; padding: 0; margin: 22px 0 0; }
  .social a { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(178, 144, 99, .4); color: var(--gold-soft); transition: background-color .2s; }
  .social a:hover { background: rgba(178, 144, 99, .15); }
  .col-h { font-family: var(--font-body); font-size: .72rem; letter-spacing: .28em; text-transform: uppercase; color: var(--gold-soft); margin-bottom: 16px; font-weight: 500; }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .col a, address a { color: #d9dbe4; text-decoration: none; font-size: .92rem; }
  .col a:hover, address a:hover { color: var(--gold-soft); text-decoration: underline; text-underline-offset: 4px; }
  address { font-style: normal; display: grid; gap: 10px; }
  address a span { display: block; }
  .hours { font-size: .9rem; color: #b8bccb; }
  .bottom { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding-block: 24px 32px; border-top: 1px solid rgba(178, 144, 99, .2); font-size: .8rem; color: #a9aec0; }
  .legal { display: flex; flex-wrap: wrap; gap: 20px; list-style: none; margin: 0; padding: 0; }
  .legal a, .linkish { color: #c9cbd6; text-decoration: none; font-size: .8rem; background: none; border: 0; padding: 0; cursor: pointer; }
  .legal a:hover, .linkish:hover { color: var(--gold-soft); text-decoration: underline; }
  @media (max-width: 900px) { .top { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .top { grid-template-columns: 1fr; } }
</style>
