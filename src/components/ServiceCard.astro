---
import type { Service } from '../content/services';
interface Props { service: Service; index: number }
const { service: s, index } = Astro.props;
---
<li class="card" data-audiences={s.audiences.join(' ')} data-reveal style={`transition-delay:${index * 70}ms`}>
  <a href={`/services/${s.slug}/`}>
    <span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <h3 class="h-card">{s.title}</h3>
    <p class="tag">{s.tagline}</p>
    <p class="sum">{s.summary}</p>
    <span class="more" aria-hidden="true">Explore <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span>
    <span class="match" aria-hidden="true">Relevant to you</span>
  </a>
</li>

<style>
  .card { list-style: none; }
  a { position: relative; display: flex; flex-direction: column; height: 100%; padding: 32px 30px 28px; text-decoration: none; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); transition: border-color .3s var(--ease), transform .3s var(--ease), box-shadow .3s var(--ease); }
  a:hover { border-color: var(--accent); transform: translateY(-3px); box-shadow: var(--shadow); }
  .num { font-family: var(--font-display); color: var(--accent-text); }
  .h-card { margin-top: 16px; }
  .tag { margin-top: 10px; font-weight: 500; color: var(--heading); font-size: .95rem; }
  .sum { margin-top: 12px; font-size: .93rem; color: var(--muted); flex: 1; }
  .more { margin-top: 22px; display: inline-flex; gap: 8px; align-items: center; font-size: .75rem; letter-spacing: .18em; text-transform: uppercase; color: var(--accent-text); font-weight: 500; }
  .match { position: absolute; top: 20px; right: 20px; font-size: .65rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; padding: 5px 10px; border-radius: 999px; background: var(--gold); color: var(--navy); opacity: 0; transform: translateY(-4px); transition: opacity .3s var(--ease), transform .3s var(--ease); }
  :global([data-highlight]) > a { border-color: var(--accent); box-shadow: var(--shadow); }
  :global([data-highlight]) .match { opacity: 1; transform: none; }
  :global([data-dim]) > a { background: transparent; border-style: dashed; }
</style>
