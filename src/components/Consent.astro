---
import { site } from '../config/site';
// Production: the firm's iubenda widget handles consent, as on the current site.
// Without it (the gift preview, or if iubenda is ever dropped): this lightweight banner.
const useBuiltIn = !site.iubenda.widgetSrc;
---
{!useBuiltIn && (
  <script is:inline define:vars={{ src: site.iubenda.widgetSrc }}>
    // Load the consent widget once the page itself has loaded, so it never delays first paint.
    addEventListener('load', function () {
      setTimeout(function () { var s = document.createElement('script'); s.src = src; s.async = true; document.head.appendChild(s); }, 0);
    });
  </script>
)}

{useBuiltIn && (
  <div class="consent" data-consent-banner role="region" aria-label="Cookie choices" hidden>
    <div class="inner">
      <div class="copy">
        <p class="title">Your privacy choices</p>
        <p>This site uses only the storage it needs to work, such as remembering your light or dark theme. No advertising or tracking cookies are set. <a href="/cookie-policy/">Cookie Policy</a></p>
        <p class="gpc" data-gpc hidden>Global Privacy Control detected: optional cookies stay off.</p>
        <div class="prefs" data-prefs hidden>
          <label><input type="checkbox" checked disabled /> Necessary (always on)</label>
          <label><input type="checkbox" data-optional /> Optional analytics (none in use today)</label>
        </div>
      </div>
      <div class="actions">
        <button type="button" class="btn btn-solid" data-choice="necessary">Necessary only</button>
        <button type="button" class="btn btn-ghost" data-choice="all">Accept all</button>
        <button type="button" class="linkish" data-toggle-prefs aria-expanded="false">Preferences</button>
      </div>
    </div>
  </div>
)}

{useBuiltIn && (
  <script>
    const KEY = 'sb-consent';
    const banner = document.querySelector<HTMLElement>('[data-consent-banner]')!;
    const gpc = (navigator as any).globalPrivacyControl === true;
    const optional = banner.querySelector<HTMLInputElement>('[data-optional]')!;
    if (gpc) { banner.querySelector<HTMLElement>('[data-gpc]')!.hidden = false; optional.disabled = true; }

    const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
    const save = (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* blocked: choice lasts for this page */ } };
    const open = () => { banner.hidden = false; banner.querySelector<HTMLButtonElement>('[data-choice="necessary"]')!.focus(); };
    const close = () => { banner.hidden = true; };

    if (!read()) banner.hidden = false;
    banner.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      if (b.dataset.togglePrefs !== undefined) {
        const prefs = banner.querySelector<HTMLElement>('[data-prefs]')!;
        prefs.hidden = !prefs.hidden;
        b.setAttribute('aria-expanded', String(!prefs.hidden));
        return;
      }
      if (b.dataset.choice) {
        const wantsOptional = !gpc && (b.dataset.choice === 'all' || optional.checked);
        save(wantsOptional ? 'all' : 'necessary');
        close();
      }
    });
    banner.addEventListener('keydown', (e) => { if (e.key === 'Escape' && read()) close(); });
    document.querySelectorAll('[data-consent-open]').forEach((b) => b.addEventListener('click', open));
  </script>
)}

<style>
  .consent { position: fixed; z-index: 60; left: 16px; right: 16px; bottom: 16px; max-width: 980px; margin-inline: auto; background: var(--navy-deep); color: #d9dbe4; border: 1px solid rgba(178, 144, 99, .4); border-radius: 16px; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, .7); }
  .inner { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; padding: 20px 24px; }
  .copy { flex: 1 1 420px; display: grid; gap: 6px; font-size: .88rem; }
  .title { font-family: var(--font-display); color: #f6f2ea; font-size: 1.15rem; }
  .copy a { color: var(--gold-soft); }
  .gpc { color: var(--gold-soft); }
  .prefs { display: grid; gap: 6px; margin-top: 6px; }
  .prefs input { accent-color: var(--gold); margin-right: 8px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .actions .btn { padding: 12px 18px; font-size: .68rem; }
  .actions .btn-ghost { color: var(--gold-soft); }
  .linkish { background: none; border: 0; color: #c9cbd6; text-decoration: underline; cursor: pointer; font-size: .82rem; padding: 8px; }
</style>
