---
import { audiences } from '../content/firm';
import { services, isListed } from '../content/services';
interface Props { id: string }
const { id } = Astro.props;
const counts = Object.fromEntries(audiences.map((a) => [a.id, services.filter((s) => isListed(s) && s.audiences.includes(a.id)).length]));
const names = Object.fromEntries(audiences.map((a) => [a.id, a.name]));
---
<div class="picker" data-audience-picker data-counts={JSON.stringify(counts)} data-names={JSON.stringify(names)}>
  <fieldset>
    <legend><span class="eyebrow">Which one are you?</span><span class="hint">Choose one and the page re-centers on what matters to you.</span></legend>
    <div class="cards">
      {audiences.map((a) => (
        <label class="card" style={`--img:url(${a.image})`}>
          <input type="radio" name={`aud-${id}`} value={a.id} />
          <span class="name">{a.name}</span>
          <span class="short">{a.short}</span>
          <span class="tick" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="foot">
    <p role="status" class="status"></p>
    <button type="button" class="clear" data-clear hidden>Clear</button>
  </div>
</div>

<script>
  import { applyAudience, getAudience, setAudience } from '../lib/audience';
  import type { AudienceId } from '../content/types';

  const pickers = [...document.querySelectorAll<HTMLElement>('[data-audience-picker]')];
  const sync = (id: AudienceId | null) => {
    for (const p of pickers) {
      p.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => (r.checked = r.value === id));
      p.querySelector<HTMLButtonElement>('[data-clear]')!.hidden = !id;
      const counts = JSON.parse(p.dataset.counts!), names = JSON.parse(p.dataset.names!);
      p.querySelector('.status')!.textContent = id
        ? `Showing what matters most to ${names[id]}: ${counts[id]} services highlighted.`
        : '';
    }
  };
  for (const p of pickers) {
    p.addEventListener('change', (e) => {
      const id = (e.target as HTMLInputElement).value as AudienceId;
      setAudience(id);
      sync(id);
    });
    p.querySelector('[data-clear]')!.addEventListener('click', () => {
      setAudience(null);
      sync(null);
      p.querySelector<HTMLInputElement>('input[type=radio]')?.focus();
    });
  }
  const saved = getAudience();
  if (saved) {
    applyAudience(saved);
    sync(saved);
    // Let the timeline (and anything else listening) catch up once everything has loaded.
    window.addEventListener('load', () => window.dispatchEvent(new CustomEvent('sb:audience', { detail: saved })));
  }
</script>

<style>
  .picker { margin-bottom: clamp(32px, 5vw, 56px); }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { display: grid; gap: 8px; margin-bottom: 18px; padding: 0; }
  .hint { color: var(--muted); font-size: .95rem; }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .card { position: relative; display: grid; align-content: end; gap: 6px; min-height: 190px; padding: 20px; border-radius: var(--radius); cursor: pointer; overflow: hidden; color: #f6f2ea; isolation: isolate; border: 1px solid transparent; transition: transform .3s var(--ease), border-color .3s var(--ease); }
  .card::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(13, 22, 41, .35), rgba(13, 22, 41, .92) 70%), var(--img) center / cover; transition: transform .6s var(--ease); }
  .card:hover::before { transform: scale(1.04); }
  .card:hover { transform: translateY(-2px); }
  .card input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .card:has(input:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .card:has(input:checked) { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold), var(--shadow); }
  .name { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.15; }
  .short { font-size: .82rem; line-height: 1.5; color: #d4d6df; }
  .tick { position: absolute; top: 14px; right: 14px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; border: 1px solid rgba(255, 255, 255, .5); color: transparent; transition: background-color .2s, color .2s; }
  .card:has(input:checked) .tick { background: var(--gold); border-color: var(--gold); color: var(--navy); }
  .foot { display: flex; align-items: center; gap: 16px; min-height: 40px; margin-top: 14px; }
  .status { color: var(--heading); font-size: .92rem; }
  .clear { background: none; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: .8rem; cursor: pointer; color: var(--heading); }
  .clear:hover { border-color: var(--accent); }
  @media (max-width: 960px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .cards { grid-template-columns: 1fr; } .card { min-height: 140px; } }
</style>
