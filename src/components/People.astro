---
import { team } from '../content/firm';
const groups = [team.filter((p) => p.partner), team.filter((p) => !p.partner)];
---
{groups.map((group, g) => (
<ul class:list={['people', g === 0 ? 'partners' : 'staff']} role="list">
  {group.map((p, i) => (
    <li class:list={['person', { partner: p.partner }]} data-reveal style={`transition-delay:${i * 70}ms`}>
      <div class="portrait">
        {p.photo
          ? <img src={p.photo} alt="" width="480" height="600" loading="lazy" />
          : <span class="mono" aria-hidden="true">{p.initials}</span>}
      </div>
      <h3 class="name">{p.name}</h3>
      <p class="role">{p.role}</p>
      {p.bio && (
        <details class="more">
          <summary>About {p.name.split(' ')[0]}</summary>
          <p class="bio">{p.bio}</p>
          {p.personal && <p class="bio">{p.personal}</p>}
        </details>
      )}
    </li>
  ))}
</ul>
))}

<style>
  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(20px, 3vw, 36px); align-items: start; }
  .partners { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .staff { grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); margin-top: clamp(28px, 4vw, 48px); }
  .portrait { aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; display: grid; place-items: center; background: radial-gradient(120% 90% at 30% 10%, var(--navy-lift), var(--navy) 55%, var(--navy-deep)); border: 1px solid rgba(178, 144, 99, .3); position: relative; }
  .partner .portrait { aspect-ratio: 16 / 11; }
  .portrait::after { content: ''; position: absolute; inset: 14px; border: 1px solid rgba(178, 144, 99, .25); border-radius: calc(var(--radius) - 6px); pointer-events: none; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .mono { font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 4.4rem); letter-spacing: .04em; background: linear-gradient(160deg, #f0dcb8, var(--gold) 60%, #8d6f48); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .name { margin-top: 18px; font-size: 1.45rem; }
  .role { margin-top: 4px; font-size: .78rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent-text); font-weight: 500; }
  .more { margin-top: 12px; }
  .more summary { cursor: pointer; font-size: .8rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-text); width: fit-content; }
  .bio { margin-top: 10px; font-size: .95rem; color: var(--text); }
  @media (max-width: 760px) {
    .staff { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .partners { grid-template-columns: minmax(0, 1fr); }
  }
</style>
