---
// The capabilities as an editorial index: one full-width row per service, so any count fills evenly.
import type { Service } from '../content/services';
interface Props { items: Service[]; compact?: boolean; numberFrom?: number }
const { items, compact = false, numberFrom = 1 } = Astro.props;
---
<ol class:list={['svc-index', { compact }]} role="list">
  {items.map((s, i) => (
    <li data-audiences={s.audiences.join(' ')}>
      <a href={`/services/${s.slug}/`}>
        <span class="num" aria-hidden="true">{String(i + numberFrom).padStart(2, '0')}</span>
        <span class="head">
          <span class="match">Relevant to you</span>
          <span class="svc-title">{s.title}</span>
          <span class="tag">{s.tagline}</span>
        </span>
        {!compact && <span class="sum">{s.summary}</span>}
        {!compact && <span class="thumb" aria-hidden="true"><img src={s.image} alt="" width="264" height="176" loading="lazy" /></span>}
        <span class="go" aria-hidden="true"><svg viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></span>
      </a>
    </li>
  ))}
</ol>

<style>
  .svc-index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  a { position: relative; display: grid; grid-template-columns: 3.2rem minmax(0, 1.1fr) minmax(0, 1.3fr) 132px 2rem; gap: clamp(16px, 3vw, 40px); align-items: center; padding: 28px 16px; text-decoration: none; color: inherit; transition: background-color .25s var(--ease); }
  .compact a { grid-template-columns: 3.2rem minmax(0, 1fr) 2rem; padding-block: 20px; }
  a:hover { background: var(--surface); }
  .num { font-family: var(--font-display); color: var(--accent-text); font-size: 1.05rem; align-self: start; padding-top: 6px; }
  .head { display: grid; gap: 6px; }
  .svc-title { font-family: var(--font-display); color: var(--heading); font-size: clamp(1.45rem, 2.3vw, 1.95rem); line-height: 1.12; transition: color .25s; }
  .compact .svc-title { font-size: clamp(1.2rem, 1.8vw, 1.45rem); }
  .tag { font-size: .92rem; font-weight: 500; color: var(--text); }
  .sum { font-size: .95rem; line-height: 1.7; color: var(--muted); }
  .thumb { display: block; width: 132px; aspect-ratio: 3 / 2; border-radius: 10px; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85); transition: filter .3s var(--ease); }
  a:hover .thumb img { filter: none; }
  .go { color: var(--accent-text); display: grid; place-items: center; }
  a:hover .svc-title { color: var(--accent-text); }
  .match { display: none; justify-self: start; font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; padding: 3px 9px; border-radius: 999px; background: var(--gold); color: var(--navy); }
  /* "Which one are you?" re-centering */
  li[data-highlight] > a { box-shadow: inset 3px 0 0 var(--gold); }
  li[data-highlight] .match { display: inline-block; }
  li[data-dim] .svc-title { color: var(--muted); }
  li[data-dim] .thumb img { filter: grayscale(1) opacity(.6); }

  @media (max-width: 1000px) {
    a { grid-template-columns: 2.6rem minmax(0, 1fr) 2rem; row-gap: 10px; }
    .sum { grid-column: 2 / 3; }
    .thumb { display: none; }
    .go { grid-row: 1; grid-column: 3; }
  }
  @media (max-width: 480px) {
    a { grid-template-columns: 2.2rem minmax(0, 1fr) 1.5rem; gap: 12px; padding-block: 22px; }
  }
</style>
