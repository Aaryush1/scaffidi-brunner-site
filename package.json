{
  "name": "scaffidi-brunner-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:gift": "cross-env GIFT=1 astro build --outDir dist-gift",
    "preview": "astro preview",
    "preview:gift": "npm run build:gift && astro preview --outDir dist-gift",
    "check:flags": "astro build && node scripts/check-flags-off.mjs",
    "check:live": "node scripts/check-live-urls.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/gilda-display": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0",
    "sirv-cli": "^3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x || 24.x"
  }
}
